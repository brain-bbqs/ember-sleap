{
  "name": "ember-sleap",
  "version": "0.2.0",
  "description": "Label, train and predict with SLEAP on data in the EMBER archive: the SLEAP web app embedded in a BBQS page that opens and saves on EMBER.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config configs/vite.config.ts",
    "build": "tsc --noEmit && vite build --config configs/vite.config.ts",
    "preview": "vite preview --config configs/vite.config.ts",
    "test": "vitest run --config configs/vitest.config.ts",
    "test:watch": "vitest --config configs/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config configs/vitest.config.ts",
    "test:integration": "playwright test --config configs/playwright.config.ts",
    "test:chromatic": "playwright test --config configs/playwright.chromatic.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config configs/eslint.config.js .",
    "format": "prettier --config configs/prettier.config.js --write .",
    "format:check": "prettier --config configs/prettier.config.js --check .",
    "storybook": "storybook dev -p 6006 --config-dir configs/storybook",
    "build-storybook": "storybook build --config-dir configs/storybook"
  },
  "devDependencies": {
    "@brain-bbqs/config": "^0.2.0",
    "@brain-bbqs/test-utils": "^0.3.0",
    "@chromatic-com/playwright": "^0.14.11",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@storybook/html-vite": "^10.5.3",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.0",
    "chromatic": "^18.0.1",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "storybook": "^10.5.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@brain-bbqs/ember-client": "^0.2.0",
    "@brain-bbqs/ui": "^0.4.0",
    "@brain-bbqs/utils": "^0.2.0",
    "@talmolab/sleap-app": "github:brain-bbqs/sleap-app#22ae87bd43de8c1287e422d23961502ff2e85da8",
    "@talmolab/sleap-io.js": "^0.5.16"
  }
}
