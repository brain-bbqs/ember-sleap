# Agent skills, written by `apm install --frozen` from the packages apm.yml pins. Never edit these
# copies: fix a skill in its own repository and move the pin.
# (`apm_modules/` unanchored: that exact line is what APM looks for before adding its own.)
apm_modules/
.claude/skills/
.agents/skills/
